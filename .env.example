# ===== 数据库 =====
# 生产部署建议用绝对路径（standalone 运行目录下的 data）
# DATABASE_URL="file:/opt/onedeal/.next/standalone/data/onedeal.db"
DATABASE_URL="file:./data/onedeal.db"

# ===== 登录认证（Auth.js v5）=====
# AUTH_SECRET：会话签名密钥，必须随机且唯一，生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# 管理员账号
ADMIN_USERNAME="admin"
# 密码哈希（格式 scrypt:<saltHex>:<hashHex>），用 scripts/set-password.mjs 设置：
#   node scripts/set-password.mjs 你的密码
ADMIN_PASSWORD_HASH=""
